# ECP5 template constraints
# Fill PACKAGEPIN values for your board.

# Clock
LOCATE COMP "sys_clk" SITE "<CLK_PIN>";
IOBUF PORT "sys_clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "sys_clk" 100.0 MHz;

# Reset + UART
LOCATE COMP "sys_rst_n" SITE "<RST_PIN>";
IOBUF PORT "sys_rst_n" IO_TYPE=LVCMOS33;

LOCATE COMP "uart_rx" SITE "<UART_RX_PIN>";
IOBUF PORT "uart_rx" IO_TYPE=LVCMOS33;

LOCATE COMP "uart_tx" SITE "<UART_TX_PIN>";
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;

# LEDs
LOCATE COMP "led[0]" SITE "<LED0_PIN>";
LOCATE COMP "led[1]" SITE "<LED1_PIN>";
LOCATE COMP "led[2]" SITE "<LED2_PIN>";
LOCATE COMP "led[3]" SITE "<LED3_PIN>";
LOCATE COMP "led[4]" SITE "<LED4_PIN>";
LOCATE COMP "led[5]" SITE "<LED5_PIN>";
LOCATE COMP "led[6]" SITE "<LED6_PIN>";
LOCATE COMP "led[7]" SITE "<LED7_PIN>";

IOBUF PORT "led[0]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[4]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[6]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[7]" IO_TYPE=LVCMOS33;
