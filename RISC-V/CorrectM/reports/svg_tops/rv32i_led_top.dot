digraph "rv32i_led_top" {
label="rv32i_led_top";
rankdir="LR";
remincross=true;
n1 [ shape=diamond, label="alu_result_out", color="black", fontcolor="black" ];
n2 [ shape=diamond, label="instr_out", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="led", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="led_mmio", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="pc_out", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="reg_rs1_out", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="reg_rs2_out", color="black", fontcolor="black" ];
n8 [ shape=diamond, label="reset", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="sys_clk", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="sys_rst_n", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="uart_rx", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="uart_tx", color="black", fontcolor="black" ];
n13 [ shape=diamond, label="wb_data_out", color="black", fontcolor="black" ];
c16 [ shape=record, label="{{<p14> A}|$12\n$not|{<p15> Y}}",  ];
c19 [ shape=record, label="{{<p17> clk|<p8> reset|<p11> uart_rx}|cpu\nriscv_top|{<p1> alu_result_out|<p2> instr_out|<p18> led_out|<p5> pc_out|<p6> reg_rs1_out|<p7> reg_rs2_out|<p12> uart_tx|<p13> wb_data_out}}",  ];
x0 [shape=box, style=rounded, label="BUF", ];
c19:p1:e -> n1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n10:e -> c16:p14:w [color="black", fontcolor="black", label=""];
n11:e -> c19:p11:w [color="black", fontcolor="black", label=""];
c19:p12:e -> n12:w [color="black", fontcolor="black", label=""];
c19:p13:e -> n13:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c19:p2:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x0:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c19:p18:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> x0:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c19:p5:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c19:p6:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c19:p7:e -> n7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c16:p15:e -> n8:w [color="black", fontcolor="black", label=""];
n8:e -> c19:p8:w [color="black", fontcolor="black", label=""];
n9:e -> c19:p17:w [color="black", fontcolor="black", label=""];
}
